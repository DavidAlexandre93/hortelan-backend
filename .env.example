APP_NAME=Hortelan Backend
APP_VERSION=1.0.0
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
ENABLE_METRICS=true

# Segurança
API_KEY=
ENFORCE_API_KEY_IN_PRODUCTION=true
RATE_LIMIT_PER_MINUTE=120
EXTERNAL_TIMEOUT_SECONDS=5.0
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_METHODS=["GET","POST","OPTIONS"]
CORS_HEADERS=["Authorization","Content-Type","Idempotency-Key","X-API-Key","X-Request-ID"]

AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=
AWS_IOT_TOPIC_PREFIX=hortelan/devices

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=hortelan.telemetry
KAFKA_TOPIC_COMMANDS=hortelan.commands

REDIS_URL=redis://localhost:6379/0

RELATIONAL_DB_URL=sqlite+aiosqlite:///./hortelan.db
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=hortelan

WEB3_RPC_URL=http://localhost:8545
WEB3_CONTRACT_ADDRESS=
WEB3_CONTRACT_ABI_JSON=[]
WEB3_ACCOUNT_PRIVATE_KEY=not-configured

OTEL_ENABLED=true
OTEL_SERVICE_NAME=hortelan-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_TIMEOUT=10

CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10
CIRCUIT_BREAKER_MINIMUM_CALLS=5
CIRCUIT_BREAKER_WAIT_DURATION_SECONDS=30
CIRCUIT_BREAKER_PERMITTED_HALF_OPEN_CALLS=2
